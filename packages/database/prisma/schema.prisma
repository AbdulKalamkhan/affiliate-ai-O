// AI_OS — Phase-00 Money-First MVP schema.
// Additive-only. Business/Affiliate subset from AI_OS_Agent_Documentation.md §10.
// Provider/network-neutral: `provider` is a string key; provider APIs are never
// hard-coded into core logic (non-negotiable #9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Content channels are CONFIG values, not business logic: add a value here +
// front the list in the API config when a new channel is adopted. Core code
// never branches on channel names (provider/channel-neutral rule).
enum Channel {
  PINTEREST
}

// --- Business / Affiliate, Phase-00 (opportunity list — manual, no scoring yet) ---

model Opportunity {
  id        String   @id @default(cuid())
  name      String
  category  String?
  notes     String?
  status    String   @default("researching") // researching | shortlisted | live
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  evidence  OpportunityEvidence[]

  @@index([status])
  @@map("opportunities")
}

// Phase-02: evidence-backed opportunity intelligence. Each research item records
// the claim, its evidence QUALITY class (FACT | ESTIMATE | INFERENCE | PREDICTION |
// UNKNOWN) and a typed scoring factor from the canonical weight set in
// apps/api opportunity-intelligence. Deterministic scoring + ranking is computed
// server-side from these rows; the engine never treats a trend as profit.
model OpportunityEvidence {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  factor        String // canonical factor key, e.g. "demand", "trend", "competition" (see WEIGHT_SET)
  quality       String      @default("UNKNOWN") // FACT | ESTIMATE | INFERENCE | PREDICTION | UNKNOWN
  claim         String // the evidence statement (e.g. live page fact, sourced figure)
  source        String? // source reference, e.g. "amazon.in live page 2026-09-25"
  value         Float // component value 0..1 used by the weight set (0.0..1.0)
  capturedAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([opportunityId, factor])
  @@map("opportunity_evidence")
}

// --- Affiliate Engine, Phase-00 (Affiliate-05: link generator + click tracking) ---

model AffiliateLink {
  id             String   @id @default(cuid())
  provider       String // e.g. "amazon-associates" (adapter key — not business logic)
  channel        Channel  @default(PINTEREST) // target content channel (config value, see enum)
  offer          String? // offer/product identifier from the provider (ASIN for Amazon)
  campaign       String? // campaign label (Phase-00 simplification: campaigns are later-phase entities)
  destination    String
  trackingParams Json?
  // Manual product metadata for Phase-00 (no PA-API). Auto-fetch arrives by replacing
  // the product-data provider (interface in apps/api) — this stays manual until then.
  productTitle   String?
  productImageUrl String?
  productPrice   String?
  productCurrency String?
  createdAt      DateTime @default(now())
  clicks         AffiliateLinkClick[]
  contentAssets  ContentAsset[]
  revenueEvents  RevenueEvent[]

  @@index([provider, createdAt])
  @@map("affiliate_links")
}

// Privacy-aware click tracker — raw IPs are not stored by default.
model AffiliateLinkClick {
  id         String         @id @default(cuid())
  linkId     String
  link       AffiliateLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)
  country    String?
  referrer   String?
  userAgent  String?
  occurredAt DateTime       @default(now())

  @@index([linkId, occurredAt])
  @@map("affiliate_link_clicks")
}

// Content asset = ONE publishable unit for a content channel (Phase-00: Pinterest
// pin). destination = the already-tracked affiliate link (Task 5). Publishing is
// manual by the Owner until SOC-04 API automation (later phase). Amazon/FTC
// compliance requires disclosureAdded=true before published=true (17_AMAZON_COMPLIANCE).
model ContentAsset {
  id             String         @id @default(cuid())
  title          String // pin title
  description    String? // pin description (captions often carry the affiliate disclosure)
  linkId         String
  link           AffiliateLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)
  published      Boolean        @default(false)
  publishedAt    DateTime? // manual publish date — set by Owner when the pin goes live
  disclosureAdded Boolean       @default(false) // Amazon/FTC affiliate disclosure present
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([linkId])
  @@index([published])
  @@map("content_assets")
}

// Verified revenue event from a network/provider (Affiliate-06).
// Only events with provider evidence and status reconciled produce profit records.
model RevenueEvent {
  id           String          @id @default(cuid())
  provider     String
  sourceId     String? // provider's own event/idempotency id for reconciliation
  eventType    String          @default("sale")
  value        Decimal         @db.Decimal(12, 2)
  currency     String          @default("INR")
  linkId       String?
  link         AffiliateLink?  @relation(fields: [linkId], references: [id])
  status       String          @default("pending") // pending -> reconciled | rejected
  occurredAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())
  profitRecord ProfitRecord?

  @@unique([provider, sourceId])
  @@index([provider, occurredAt])
  @@map("revenue_events")
}

// Verified profit record (AN-02): netProfit = grossAmount - feeAmount - costAmount.
// Never treat gross sales as profit.
model ProfitRecord {
  id            String        @id @default(cuid())
  sourceType    String        @default("affiliate") // "affiliate" now; "seller" later — never mixing estimates with actuals
  source        String        // provider/evidence reference
  grossAmount   Decimal       @db.Decimal(12, 2)
  feeAmount     Decimal       @db.Decimal(12, 2)
  costAmount    Decimal       @db.Decimal(12, 2)
  netProfit     Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  revenueEventId String?       @unique
  revenueEvent  RevenueEvent? @relation(fields: [revenueEventId], references: [id])
  recordedAt    DateTime      @default(now())
  status        String        @default("recorded")

  @@index([sourceType, recordedAt])
  @@map("profit_records")
}

// --- Boss / AI CEO Core, Phase-01 (Foundation + AI CEO Core) ---
// Owner command intake → structured, auditable PLAN. Per phase-01 gate, safe Owner
// commands produce a structured auditable plan WITHOUT external execution. Actions
// are always stored as proposals (status "proposed"); the global API-key guard +
// per-tool autonomy check decide whether they COULD run — nothing executes here.

model BossCommand {
  id            String          @id @default(cuid())
  text          String          // owner command text
  autonomyLevel Int             @default(2) // CEO operating model: 0 observe .. 5 controlled; default 2 = prepare drafts/plans
  status        String          @default("received") // received -> planned (never "executed" in Phase-01)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  plan          BossPlan?
  auditLogs     BossAuditLog[]
  decisions     BossDecision[]
  lessons       BossLesson[]

  @@index([createdAt])
  @@map("boss_commands")
}

model BossPlan {
  id        String      @id @default(cuid())
  commandId String      @unique
  command   BossCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  objective String
  status    String      @default("planned") // planned only in Phase-01 — no external execution
  tasks     BossTask[]
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@map("boss_plans")
}

model BossTask {
  id        String      @id @default(cuid())
  planId    String
  plan      BossPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  status    String      @default("planned")
  actions   BossAction[]
  createdAt DateTime    @default(now())

  @@index([planId, order])
  @@map("boss_tasks")
}

model BossAction {
  id               String   @id @default(cuid())
  taskId           String
  task             BossTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tool             String   // typed tool contract name (see apps/api/src/boss/tools.ts)
  input            Json     // typed tool input payload
  autonomyLevel    Int      @default(2) // autonomy level the command was evaluated at
  requiredAutonomy Int      @default(2) // tool contract's required autonomy level
  permissionResult String   @default("granted") // granted | denied (autonomy check)
  status           String   @default("proposed") // proposed -> approval_required -> approved -> executed | failed | denied
  createdAt        DateTime @default(now())

  approvals    BossApproval[]
  toolCalls    BossToolCall[]
  lessons      BossLesson[]

  @@index([taskId])
  @@index([status, createdAt])
  @@map("boss_actions")
}

model BossAuditLog {
  id        String       @id @default(cuid())
  commandId String?
  command   BossCommand? @relation(fields: [commandId], references: [id], onDelete: Cascade)
  entityType String      // command | plan | task | action | approval | tool_call | decision | lesson
  entityId  String
  verb      String       // created | planned | permission_checked | denied | requested | approved | ...
  actor     String?      // who caused the transition (e.g. "owner", "executor"); null = system/unknown
  detail    Json?
  createdAt DateTime     @default(now())

  @@index([commandId, createdAt])
  @@index([entityType, createdAt])
  @@map("boss_audit_logs")
}
// --- Boss Approvals (HITL) ---
model BossApproval {
  id           String   @id @default(cuid())
  actionId     String
  action       BossAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  status       String   @default("pending") // pending | approved | rejected | expired
  reason       String?
  decidedBy    String?
  decidedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([actionId, status])
  @@map("boss_approvals")
}

model BossToolCall {
  id           String   @id @default(cuid())
  actionId     String
  action       BossAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  tool         String
  input        Json
  output       Json?
  status       String   @default("pending")
  error        String?
  durationMs   Int?
  executedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([actionId, status])
  @@index([tool, createdAt])
  @@map("boss_tool_calls")
}

model BossDecision {
  id           String   @id @default(cuid())
  commandId    String?
  command      BossCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull)
  decision     String
  rationale    String
  factors      Json?
  confidence   Decimal? @db.Decimal(4, 2)
  outcome      String?
  executed     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lessons      BossLesson[]
  @@index([commandId, createdAt])
  @@map("boss_decisions")
}

model BossMemory {
  id           String   @id @default(cuid())
  key          String   @unique
  kind         String
  value        Json
  weight       Decimal  @db.Decimal(6, 3) @default(1.0)
  confidence   Decimal? @db.Decimal(4, 2)
  source       String?
  tags         Json?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([kind, lastSeenAt])
  @@map("boss_memory")
}
model BossLesson {
  id           String   @id @default(cuid())
  decisionId   String?
  decision     BossDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  commandId    String?
  command      BossCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull)
  actionId     String?
  action       BossAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  prediction   String?
  actual       String?
  success      Boolean?
  lesson       String
  tags         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([success, createdAt])
  @@map("boss_lessons")
}
// --- Marketplace/Seller Foundation (additive, not yet connected) ---
enum SellerPlatform {
  AMAZON_SELLER
  FLIPKART_SELLER
  MEESHO_SUPPLIER
}

model SellerAccount {
  id           String         @id @default(cuid())
  platform     SellerPlatform
  displayName  String
  externalId   String?
  status       String         @default("inactive")
  connected    Boolean        @default(false)
  lastSyncAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  permissions  SellerPermission[]
  listings     SellerListing[]
  inventories  SellerInventory[]
  orders       SellerOrder[]
  returns      SellerReturn[]
  settlements  SellerSettlement[]
  @@index([platform, status])
  @@map("seller_accounts")
}

model SellerPermission {
  id           String        @id @default(cuid())
  sellerId     String
  seller       SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  permission   String
  granted      Boolean       @default(false)
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([sellerId, granted])
  @@map("seller_permissions")
}

model Product {
  id           String           @id @default(cuid())
  sku          String?          @unique
  title        String
  description  String?          @db.Text
  brand        String?
  category     String?
  costPrice    Decimal?         @db.Decimal(12, 2)
  currency     String           @default("INR")
  source       String           @default("manual")
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  variants     ProductVariant[]
  listings     SellerListing[]
  inventories  SellerInventory[]
  @@index([sku, active])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String?  @unique
  title        String?
  attributes   Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([productId, active])
  @@map("product_variants")
}

model SellerListing {
  id           String        @id @default(cuid())
  sellerId     String
  seller       SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalId   String?
  platform     SellerPlatform
  status       String        @default("draft")
  title        String
  description  String?       @db.Text
  bullets      Json?
  attributes   Json?
  price        Decimal?      @db.Decimal(12, 2)
  currency     String        @default("INR")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  versions     SellerListingVersion[]
  @@index([sellerId, platform, status])
  @@map("seller_listings")
}

model SellerListingVersion {
  id           String        @id @default(cuid())
  listingId    String
  listing      SellerListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  version      Int
  payload      Json
  status       String        @default("draft")
  externalId   String?
  notes        String?
  createdAt    DateTime      @default(now())
  @@unique([listingId, version])
  @@map("seller_listing_versions")
}

model SellerInventory {
  id           String        @id @default(cuid())
  sellerId     String
  seller       SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku          String?
  availableQty Int           @default(0)
  reservedQty  Int           @default(0)
  soldQty      Int           @default(0)
  currency     String        @default("INR")
  updatedAt    DateTime      @updatedAt
  createdAt    DateTime      @default(now())
  @@index([sellerId, sku])
  @@map("seller_inventories")
}

model SellerOrder {
  id           String        @id @default(cuid())
  sellerId     String
  seller       SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  externalId   String
  platform     SellerPlatform
  status       String        @default("pending")
  totalAmount  Decimal       @db.Decimal(12, 2)
  currency     String        @default("INR")
  raw          Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        SellerOrderItem[]
  @@unique([platform, externalId])
  @@index([sellerId, status, createdAt])
  @@map("seller_orders")
}

model SellerOrderItem {
  id           String      @id @default(cuid())
  orderId      String
  order        SellerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku          String?
  title        String
  quantity     Int
  unitPrice    Decimal     @db.Decimal(12, 2)
  currency     String      @default("INR")
  totalPrice   Decimal     @db.Decimal(12, 2)
  @@map("seller_order_items")
}

model SellerReturn {
  id           String        @id @default(cuid())
  sellerId     String
  seller       SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId      String?
  externalId   String?
  platform     SellerPlatform
  status       String        @default("requested")
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("INR")
  reason       String?
  raw          Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([sellerId, status])
  @@map("seller_returns")
}

model SellerSettlement {
  id           String        @id @default(cuid())
  sellerId     String
  seller       SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  externalId   String?
  platform     SellerPlatform
  status       String        @default("pending")
  totalAmount  Decimal       @db.Decimal(12, 2)
  // Cost components are NULLABLE: a missing platform cost is UNKNOWN, never 0.
  // 0 means "verified zero"; NULL means "not provided" (profit cannot be claimed).
  fees         Decimal?      @db.Decimal(12, 2)
  refunds      Decimal?      @db.Decimal(12, 2)
  netAmount    Decimal?      @db.Decimal(12, 2)
  // complete = every cost component verified, netAmount is real money.
  // unknown  = at least one component is UNKNOWN, netAmount is NULL (not zero).
  profitState  String        @default("unknown")
  currency     String        @default("INR")
  periodStart  DateTime?
  periodEnd    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@index([sellerId, status])
  @@map("seller_settlements")
}

// --- Phase-04 QA-01 publish approvals (replaces the hardcoded bypass) ---
// An approval is an immutable record of WHO approved a publish, WHEN, and WHY.
// Consulted by the QA gate instead of a hardcoded asset-id set.
model PublishApproval {
  id         String   @id @default(cuid())
  assetId    String
  approvedBy String
  reason     String
  evidence   Json?
  source     String   @default("owner")
  grantedAt  DateTime @default(now())

  @@index([assetId, grantedAt])
  @@map("publish_approvals")
}
