# AI_OS — local environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# PostgreSQL (Phase-00 local): dedicated role `aios`, least privilege
# (LOGIN + CREATEDB, no SUPERUSER). Database `aios` created by the init migration.
DATABASE_URL="postgresql://aios:CHANGE_ME@localhost:5432/aios?schema=public"

# API server port (default 3001)
PORT=3001

# Base URL of the API as seen by the web app (dashboard fetches server-side).
# Override with the deployed API URL later; Phase-00 runs both locally.
API_BASE_URL=http://localhost:3001

# Amazon Associates tag (SiteStripe / manual tagging). NOT a secret — it is public
# in every affiliate link. PA-API itself is blocked until the account reaches
# 10 qualifying sales in the trailing 30 days (0 today); product data stays manual.
ASSOCIATE_TAG=zorajewellery-21

# API key for authenticated client-to-server calls (create/lookup dashboard data).
# Sent as `Authorization: Bearer <API_KEY>`. MUST be a long random value in prod;
# the Render blueprint references it as a sync:false secret (set in the dashboard).
API_KEY=change-me-long-random-value

# ---------------------------------------------------------------------------
# OPTIONAL provider credential NAMES (later phases) — the provider adapter
# registry (GET /system/providers) reports an adapter "configured" only when ALL
# of its documented env var NAMES are present. Leave unset to keep an adapter
# reported as not-configured. NEVER commit real values.
# ---------------------------------------------------------------------------

# product-data/pa-api (Amazon Product Advertising API auto product data).
# Required only when PA-API eligibility is reached and the adapter is adopted.
# PA_API_ACCESS_KEY=
# PA_API_SECRET_KEY=
# PA_API_PARTNER_TAG=

# affiliate-network/second-provider (Affiliate-07 — gated behind the Money-First
# MVP gate). Choose the network, then supply its credential here.
# SECOND_NETWORK_API_KEY=

# automation/n8n (Phase-05 workflow execution webhook).
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

# research-feed/trends (Phase-02 external trend/research feed).
# RESEARCH_FEED_API_KEY=