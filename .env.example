# AI_OS — local environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# PostgreSQL (Phase-00 local): dedicated role `aios`, least privilege
# (LOGIN + CREATEDB, no SUPERUSER). Database `aios` created by the init migration.
DATABASE_URL="postgresql://aios:CHANGE_ME@localhost:5432/aios?schema=public"

# API server port (default 3001)
PORT=3001

# Base URL of the API as seen by the web app (dashboard fetches server-side).
# Override with the deployed API URL later; Phase-00 runs both locally.
API_BASE_URL=http://localhost:3001

# Amazon Associates tag (SiteStripe / manual tagging). NOT a secret — it is public
# in every affiliate link. PA-API itself is blocked until the account reaches
# 10 qualifying sales in the trailing 30 days (0 today); product data stays manual.
ASSOCIATE_TAG=zorajewellery-21

# API key for authenticated client-to-server calls (create/lookup dashboard data).
# Sent as `Authorization: Bearer <API_KEY>`. MUST be a long random value in prod;
# the Render blueprint references it as a sync:false secret (set in the dashboard).
API_KEY=change-me-long-random-value

# ---------------------------------------------------------------------------
# OPTIONAL provider credential NAMES (later phases) — the provider adapter
# registry (GET /system/providers) reports an adapter "configured" only when ALL
# of its documented env var NAMES are present. Leave unset to keep an adapter
# reported as not-configured. NEVER commit real values.
# ---------------------------------------------------------------------------

# product-data/pa-api (Amazon Product Advertising API auto product data).
# Required only when PA-API eligibility is reached and the adapter is adopted.
# PA_API_ACCESS_KEY=
# PA_API_SECRET_KEY=
# PA_API_PARTNER_TAG=

# affiliate-network/second-provider (Affiliate-07 — gated behind the Money-First
# MVP gate). Choose the network, then supply its credential here.
# SECOND_NETWORK_API_KEY=

# automation/n8n (Phase-05 workflow execution webhook).
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

# research-feed/trends (Phase-02 external trend/research feed).
# RESEARCH_FEED_API_KEY=

# ---------------------------------------------------------------------------
# AI provider boundary (P1) — see apps/api/src/ai.
#
# HONESTY: with no credential set, /ai/status reports every adapter as
# `not_configured` and every call fails closed with NOT_CONFIGURED. There is no
# fabricated completion and no silent fallback to a stub.
# ---------------------------------------------------------------------------

# Which adapter serves AI traffic. MUST name a known provider
# (openai_compatible | local | anthropic | google | mock). If unset, or if it
# names an adapter that is not configured, calls fail closed.
# AI_DEFAULT_PROVIDER=openai_compatible

# Hosted OpenAI-compatible endpoint (any /chat/completions API). The credential
# is never logged, returned, audited or persisted; prompts and responses are
# redacted before they are stored or sent onward.
# OPENAI_API_KEY=
# AI_OPENAI_BASE_URL=https://api.openai.com/v1

# Self-hosted / local server (Ollama, vLLM, LM Studio). Registered under the
# DISTINCT provider name `local`, so it is never reported as the hosted vendor.
# Model ids are NOT invented: list the ones this server actually serves.
# AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# AI_LOCAL_API_KEY=
# AI_LOCAL_MODELS=llama3.1:8b

# Offline deterministic stub. Off unless explicitly enabled, and its output is
# ALWAYS reported as unverified evidence and a real zero cost.
# AI_ENABLE_MOCK_PROVIDER=false

# Model prices, USD per 1M tokens, taken from the vendor's own pricing page.
# Left unset, cost stays UNKNOWN (null) rather than being reported as 0. This is
# configuration on purpose: a price hardcoded in source would be a claim the
# system cannot keep true.
# AI_MODEL_PRICES_JSON={"openai_compatible/gpt-4o-mini":{"input":0.15,"output":0.6}}