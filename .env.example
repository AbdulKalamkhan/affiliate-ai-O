# AI_OS — local environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# PostgreSQL (Phase-00 local): dedicated role `aios`, least privilege
# (LOGIN + CREATEDB, no SUPERUSER). Database `aios` created by the init migration.
DATABASE_URL="postgresql://aios:CHANGE_ME@localhost:5432/aios?schema=public"

# API server port (default 3001)
PORT=3001