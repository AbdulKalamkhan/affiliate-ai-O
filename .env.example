# AI_OS — local environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# PostgreSQL (Phase-00 local): dedicated role `aios`, least privilege
# (LOGIN + CREATEDB, no SUPERUSER). Database `aios` created by the init migration.
DATABASE_URL="postgresql://aios:CHANGE_ME@localhost:5432/aios?schema=public"

# API server port (default 3001)
PORT=3001

# Base URL of the API as seen by the web app (dashboard fetches server-side).
# Override with the deployed API URL later; Phase-00 runs both locally.
API_BASE_URL=http://localhost:3001

# Amazon Associates tag (SiteStripe / manual tagging). NOT a secret — it is public
# in every affiliate link. PA-API itself is blocked until the account reaches
# 10 qualifying sales in the trailing 30 days (0 today); product data stays manual.
ASSOCIATE_TAG=zorajewellery-21